DISCORD_TOKEN=
DISCORD_CLIENT_ID=
BOT_OWNER_IDS=

# 無料優先AI
AI_DEFAULT_MODE=google
AI_PAID_API_ENABLED=true

# 必要なときだけ設定
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Railway Volumeを使う場合: /app/data
DATA_DIR=./data

# 自動監視
EARTHQUAKE_POLL_SECONDS=60
WEATHER_DAILY_HOUR=7

# Google AI generation
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image
GOOGLE_VIDEO_MODEL=veo-3.1-generate-preview
